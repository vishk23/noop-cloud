PORT=8080
DATA_DIR=./data
RO_TOKEN=replace-with-32+-byte-random-read-token
RW_TOKEN=replace-with-32+-byte-random-write-token
MAX_INGEST_BYTES=262144000

# Optional, all four together: enables push-triggered on-demand sync (the request_sync MCP tool
# and POST /register-device). Leave unset and request_sync just replies {configured:false} instead
# of failing — nothing else in the server depends on these. Values come from an Apple Developer
# APNs Auth Key (.p8), which does not exist yet for this deployment.
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=ABCD123456
# APPLE_TEAM_ID=TEAM123456
# APNS_TOPIC=com.example.NOOP

# NTFY_TOPIC is not read by this server (it's a GitHub Actions repo secret for
# scripts/report.mjs) but is a SECRET, not a public slug: ntfy.sh topics are
# unauthenticated, so anyone who knows it can read your daily health push — generate
# one like `noop-$(openssl rand -hex 16)`, not a guessable name.
