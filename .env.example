PORT=8080
DATA_DIR=./data
RO_TOKEN=replace-with-32+-byte-random-read-token
RW_TOKEN=replace-with-32+-byte-random-write-token
MAX_INGEST_BYTES=262144000

# Optional, all four together: enables push-triggered on-demand sync (the request_sync MCP tool
# and POST /register-device). Leave unset and request_sync just replies {configured:false} instead
# of failing — nothing else in the server depends on these. Values come from an Apple Developer
# APNs Auth Key (.p8), which does not exist yet for this deployment.
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=ABCD123456
# APPLE_TEAM_ID=TEAM123456
# APNS_TOPIC=com.example.NOOP

# Optional, all three together: bulk object storage for the WHOOP 5/MG deep-buffer archive (#423) —
# POST /deepbuf plus the deep_buffer_coverage / deep_buffer_window MCP tools. Leave unset and
# /deepbuf returns 503 and the tools reply {configured:false}; nothing else in the server depends on
# these.
#
# THIS MUST NOT GO ON THE FLY VOLUME. The strap banks ~600 MB/DAY as hex JSONL (~9 GB/month) and the
# noop_data volume has ~547 MB free — a day of capture would fill it and take the mirror down with it.
# There is deliberately NO fallback to local disk: unconfigured means refused, not quietly written.
#
# Recommended: Cloudflare R2 (S3-compatible, ZERO egress fees — this archive is written once and read
# back repeatedly while reverse-engineering the 2140-B optical layout, so egress is the cost that
# actually bites; S3 would charge ~$0.09/GB for exactly that re-reading). ~$0.015/GB/month means a
# year of continuous capture is well under $1/month.
#   1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "noop-deepbuf"), and keep it PRIVATE.
#   2. R2 -> Manage API tokens -> Create token, scoped Object Read & Write to that bucket only.
#   3. S3_ENDPOINT is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. fly secrets set S3_BUCKET=... S3_ENDPOINT=... S3_ACCESS_KEY_ID=... S3_SECRET_ACCESS_KEY=...
# For real AWS S3 instead: drop S3_ENDPOINT and set S3_REGION to the bucket's region. Nothing else
# changes — the server talks the S3 API either way.
# S3_BUCKET=noop-deepbuf
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MAX_DEEPBUF_BYTES=25165824
# MAX_DEEPBUF_RAW_BYTES=67108864
#
# DEEPBUF_FS_DIR writes the archive to a local directory instead. TESTS AND LOCAL DEV ONLY — setting
# this in production is the "fill the volume" mistake the 503 above exists to prevent.
# DEEPBUF_FS_DIR=./data/deepbuf

# NTFY_TOPIC is not read by this server (it's a GitHub Actions repo secret for
# scripts/report.mjs) but is a SECRET, not a public slug: ntfy.sh topics are
# unauthenticated, so anyone who knows it can read your daily health push — generate
# one like `noop-$(openssl rand -hex 16)`, not a guessable name.

# --- Storage guardrails (optional; defaults are fine) -------------------------
# /ingest stages a SECOND full copy of the mirror before renaming it over the live one, so the
# volume must hold ~2x the mirror plus slack. MIN_FREE_BYTES is the slack insisted on AFTER that
# staged copy; an upload that would breach it is refused with 507 insufficient_space rather than
# half-written. Default 256 MB.
# MIN_FREE_BYTES=268435456
#
# A `.staged-*` artifact older than this is a crash corpse (a killed/OOMed ingest) and is swept at
# startup and before each ingest. The age guard is what keeps a sweep from racing a live upload, so
# do not set it near zero. Default 1 hour.
# STAGED_SWEEP_AGE_MS=3600000
